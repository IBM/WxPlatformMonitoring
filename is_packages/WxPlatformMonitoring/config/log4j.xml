<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE log4j:configuration SYSTEM "log4j.dtd" >
<log4j:configuration>
	<appender name="wx.platformMonitoring" class="org.apache.log4j.RollingFileAppender">
		<param name="append" value="false" />
		<param name="maxFileSize" value="1000KB" />
		<param name="maxBackupIndex" value="5" />
		<param name="file" value="./logs/wxplatformmonitoring.log" />
		<param name="threshold" value="trace" />
		<layout class="org.apache.log4j.PatternLayout">
			<param name="ConversionPattern" value="%d %-5p [%c] - %m%n" />
		</layout>
	</appender>


	<category name="wx.platformMonitoring" additivity="false">
		<priority value="trace" />
		<appender-ref ref="wx.platformMonitoring" />
	</category>

</log4j:configuration>
